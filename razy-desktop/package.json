{
  "name": "razy",
  "productName": "Razy",
  "version": "5.0.2",
  "description": "Razy — музыкальный плеер с Discord Rich Presence",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.razy.player",
    "productName": "Razy",
    "files": [
      "main.js",
      "preload.js",
      "mini-preload.js",
      "config.json",
      "app/**",
      "assets/icon.png",
      "server/**",
      "!server/data/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Razy-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "server/**"
    ]
  },
  "author": "Razy"
}